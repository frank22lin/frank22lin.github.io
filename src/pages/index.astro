---
import BaseLayout from "../layouts/BaseLayout.astro";
import { papers } from "../data/papers";
import { projects } from "../data/projects";

const selectedPapers = papers.filter((paper) => paper.type === "Class Paper" || paper.type === "Thesis");
const selectedPresentations = papers.filter((paper) => paper.type === "Seminar Presentation").slice(0, 2);
const selectedProjects = projects.slice(0, 2);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Personal research portfolio</p>
      <h1>Franklin Liu</h1>
      <p class="lede">
        I work on research and software projects at the intersection of technical systems,
        careful analysis, and useful interfaces.
      </p>
      <div class="hero-actions" aria-label="Primary links">
        <a class="button primary" href="/papers">View academic work</a>
        <a class="button secondary" href="/projects">View projects</a>
      </div>
    </div>
    <aside class="focus-panel" aria-label="Current focus">
      <h2>Current Focus</h2>
      <p>
        Replace this with your present research question, role, or short bio. Two crisp
        sentences will do more work than a long introduction.
      </p>
      <dl>
        <div>
          <dt>Interests</dt>
          <dd>ML systems, applied research, human-centered tools</dd>
        </div>
        <div>
          <dt>Based in</dt>
          <dd>United States</dd>
        </div>
      </dl>
    </aside>
  </section>

  <section class="section-grid">
    <div class="section-heading">
      <p class="eyebrow">Selected work</p>
      <h2>Papers</h2>
    </div>
    <div class="item-list academic-list">
      {
        selectedPapers.map((paper) => (
          <article class="academic-list-item">
            <div class="item-meta">
              <span>{paper.year}</span>
              <span>{paper.type}</span>
            </div>
            <h3>{paper.title}</h3>
            <p>{paper.summary}</p>
            <div class="tag-row">
              {paper.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-grid">
    <div class="section-heading">
      <p class="eyebrow">Talks and thesis</p>
      <h2>Presentations</h2>
    </div>
    <div class="item-list academic-list">
      {
        selectedPresentations.map((paper) => (
          <article class="academic-list-item">
            <div class="item-meta">
              <span>{paper.year}</span>
              <span>{paper.type}</span>
            </div>
            <h3>{paper.title}</h3>
            <p>{paper.summary}</p>
            <div class="link-row">
              {paper.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-grid accent-band">
    <div class="section-heading">
      <p class="eyebrow">Built things</p>
      <h2>Projects</h2>
    </div>
    <div class="item-list">
      {
        selectedProjects.map((project) => (
          <article class="list-card">
            <div class="item-meta">
              <span>{project.status}</span>
              <span>{project.role}</span>
            </div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="tag-row">
              {project.stack.map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
