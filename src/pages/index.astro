---
import BaseLayout from "../layouts/BaseLayout.astro";
import { papers } from "../data/papers";
import { projects } from "../data/projects";

const selectedPapers = papers.filter(
  (paper) => paper.type === "Research Paper" || paper.type === "Class Paper" || paper.type === "Thesis"
);
const selectedPresentations = papers.filter((paper) => paper.type === "Seminar Presentation");
const selectedProjects = projects.slice(0, 3);
---

<BaseLayout>
  <section class="profile-hero">
    <div>
      <p class="eyebrow">Personal Archive</p>
      <h1>Franklin Liu</h1>
      <p>
        I am a master's student at the University of Chicago. I completed my undergraduate
        degree at Technical University of Berlin, majoring in Mathematics with a minor in
        Computer Science.
      </p>
    </div>
    <aside class="hero-aside" aria-label="Profile links and interests">
      <div>
        <h2>Current Interests</h2>
        <p>Machine Learning, Prediction Markets, Quantitative Trading.</p>
      </div>
      <div class="profile-links" aria-label="Profile links">
        <a href="/files/franklin-liu-cv.pdf">CV</a>
        <a href="https://github.com/frank22lin">GitHub</a>
        <a href="https://www.linkedin.com/in/franklinliu22/">LinkedIn</a>
      </div>
    </aside>
  </section>

  <section class="work-section">
    <header class="section-heading">
      <h2>Selected Papers</h2>
      <p>
        A selection of course and research papers I thought would be interesting to share.
      </p>
    </header>
    <div class="academic-list">
      {
        selectedPapers.map((paper) => (
          <article class="academic-list-item">
            <div class="row-year">{paper.year}</div>
            <div class="row-body">
              <h3>{paper.title}</h3>
              <p class="row-meta">
                <span>
                  {paper.type === "Research Paper"
                    ? "Research Paper"
                    : paper.type === "Thesis"
                      ? "Undergraduate Thesis"
                      : "Course Paper"}
                </span>
              </p>
              {paper.venues && (
                <p class="row-venues">
                  {paper.venues.map((venue) => <span>{venue}</span>)}
                </p>
              )}
              <div class="tag-row">
                {paper.tags.map((tag) => <span>{tag}</span>)}
              </div>
              <p class="row-description">{paper.summary}</p>
            </div>
            <div class="row-actions">
              {paper.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="work-section">
    <header class="section-heading">
      <h2>Seminars</h2>
      <p>
        Presentation slides from past seminar talks.
      </p>
    </header>
    <div class="academic-list">
      {
        selectedPresentations.map((paper) => (
          <article class="academic-list-item">
            <div class="row-year">{paper.year}</div>
            <div class="row-body">
              <h3>{paper.title}</h3>
              <p class="row-meta">
                <span>Seminar Slides</span>
              </p>
              <div class="tag-row">
                {paper.tags.map((tag) => <span>{tag}</span>)}
              </div>
              <p class="row-description">{paper.summary}</p>
            </div>
            <div class="row-actions">
              {paper.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="work-section">
    <header class="section-heading">
      <h2>Selected Projects</h2>
      <p>
        A selection of projects I am currently working on and passionate about.
      </p>
    </header>
    <div class="academic-list">
      {
        selectedProjects.map((project) => (
          <article class="academic-list-item">
            <div class="row-year">{project.status}</div>
            <div class="row-body">
              <h3>{project.title}</h3>
              <p class="row-meta">
                <span>{project.role}</span>
              </p>
              <div class="tag-row">
                {project.tags.map((tag) => <span>{tag}</span>)}
              </div>
              <p class="row-description">{project.description}</p>
            </div>
            <div class="row-actions">
              {project.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="work-section">
    <header class="section-heading">
      <h2>Interests</h2>
      <p>
        Outside coursework and projects, I am interested in basketball and currently trying out new stuff.
      </p>
    </header>
  </section>
</BaseLayout>
