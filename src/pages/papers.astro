---
import BaseLayout from "../layouts/BaseLayout.astro";
import { papers } from "../data/papers";

const groupedPapers = [
  {
    label: "Selected Papers",
    description:
      "A selection of course and research papers I thought would be interesting to share.",
    items: papers.filter((paper) => paper.type === "Class Paper" || paper.type === "Thesis")
  },
  {
    label: "Seminars",
    description: "Presentation slides from past seminar talks.",
    items: papers.filter((paper) => paper.type === "Seminar Presentation")
  }
];
---

<BaseLayout title="Academic Work | Franklin Liu">
  <section class="page-title">
    <p class="eyebrow">Research</p>
    <h1>Academic Work</h1>
    <p>
      Selected academic writing, seminar slides, and thesis materials.
    </p>
  </section>

  <section class="content-column">
    {
      groupedPapers.map((group) => (
        group.items.length > 0 && (
          <section class="work-group" aria-labelledby={group.label.toLowerCase().replaceAll(" ", "-")}>
            <header class="section-heading">
              <h2 id={group.label.toLowerCase().replaceAll(" ", "-")}>{group.label}</h2>
              <p>{group.description}</p>
            </header>
            {group.items.map((paper) => (
              <article class="academic-list-item">
                <div class="row-year">{paper.year}</div>
                <div class="row-body">
                  <h3>{paper.title}</h3>
                  <p class="row-meta">
                    <span>
                      {paper.type === "Thesis"
                        ? "Undergraduate Thesis"
                        : paper.type === "Class Paper"
                          ? "Course Paper"
                          : "Seminar Presentation"}
                    </span>
                  </p>
                  <div class="tag-row">
                    {paper.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                  <p class="row-description">{paper.summary}</p>
                </div>
                <div class="row-actions">
                  {paper.links.map((link) => (
                    <a href={link.href}>{link.label}</a>
                  ))}
                </div>
              </article>
            ))}
          </section>
        )
      ))
    }
  </section>
</BaseLayout>
