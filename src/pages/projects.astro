---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="Projects | Franklin Liu">
  <section class="page-title">
    <p class="eyebrow">Portfolio</p>
    <h1>Selected Projects</h1>
    <p>
      A selection of projects I am currently working on and passionate about.
    </p>
  </section>

  <section class="academic-list">
    {
      projects.map((project) => (
        <article class="academic-list-item">
          <div class="row-year">{project.status}</div>
          <div class="row-body">
            <h2>{project.title}</h2>
            <p class="row-meta">
              <span>{project.role}</span>
            </p>
            <div class="tag-row">
              {project.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
            <p class="row-description">{project.description}</p>
          </div>
          <div class="row-actions">
            {project.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        </article>
      ))
    }
  </section>
</BaseLayout>
